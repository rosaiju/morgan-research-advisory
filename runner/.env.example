# Copy to runner/.env (git-ignored) or set in the Windows user environment / Credential Manager.
# NEVER commit real values. Leave blank until the user authorises stage 1.
MORGAN_ALLOW_NETWORK=0

DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Dedicated Qwen FP8 deployment (only after a separate authorisation to rent GPUs)
QWEN_DEDICATED_API_KEY=
